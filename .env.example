# Copy this file to .env and fill in your keys
# cp .env.example .env

# Databento API
DATABENTO_API_KEY=your_databento_api_key_here

# Telegram Bot (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat ID (send /start to your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id)
TELEGRAM_CHAT_ID=your_chat_id_here
